<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cleartext is permitted for addresses the user types: a WebDAV share with "Use HTTPS"
         turned off (the form warns that the password then travels in clear text), a URL check of
         an http:// page, and alert forwarding to an http:// server (the form warns too). Android
         cannot scope this to hosts the user picks at runtime. Every other HTTP request the app
         makes is to a fixed https:// URL. -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
