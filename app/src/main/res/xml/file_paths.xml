<?xml version="1.0" encoding="utf-8"?>
<!--
  FileProvider paths. Only dedicated subdirectories of the app's internal cache are exposed (crash
  reports, shared text, remote previews); no other app data is reachable through the provider.
-->
<paths>
    <cache-path
        name="crash-reports"
        path="crash-reports/" />
    <!-- Text the user chose to share, such as a Fleet run's output (see data/TextShare.kt).
         Replaced on each share. -->
    <cache-path
        name="shared-text"
        path="shared-text/" />
    <!-- Remote files streamed to cache so the device's own viewer apps (photos, video player,
         PDF reader) can open them via ACTION_VIEW. Cleared on each new preview. -->
    <cache-path
        name="remote-previews"
        path="remote-previews/" />
</paths>
